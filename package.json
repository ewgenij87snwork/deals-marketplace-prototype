{
  "name": "n5deal-marketplace-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "A lean full-stack M&A marketplace prototype for Buyer, Seller, and Platform Manager flows.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "prisma generate && next build",
    "start": "next start --port 3002",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:project": "node scripts/check-project.mjs",
    "verify:wave": "pnpm check:toolchain && pnpm check:project && pnpm lint && pnpm typecheck && pnpm test && pnpm build && git diff --check",
    "verify": "pnpm check:toolchain && pnpm check:project && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && git diff --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.540.0",
    "motion": "^12.23.0",
    "next": "16.2.11",
    "pg": "^8.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.2",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^4.0.0"
  }
}
